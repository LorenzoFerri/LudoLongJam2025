[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Cloud_Speed;
uniform sampler2D tex_vtx_9;
uniform float Cloud_Intensity;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_12;
uniform sampler2D depth_tex_frg_16 : hint_depth_texture;
uniform vec4 Explosion_Color : source_color = vec4(1.000000, 0.333333, 0.000000, 1.000000);
uniform sampler2D tex_frg_7;



void vertex() {
// Input:3
	vec3 n_out3p0 = VERTEX;


// Input:4
	vec3 n_out4p0 = NORMAL;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = Cloud_Speed;


// VectorOp:7
	vec2 n_out7p0 = vec2(n_out5p0) * n_out12p0;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out7p0 * n_in8p1 + UV;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_vtx_9, n_out8p0);


// FloatParameter:11
	float n_out11p0 = Cloud_Intensity;


// FloatOp:10
	float n_out10p0 = n_out9p0.x * n_out11p0;


// VectorOp:6
	vec3 n_out6p0 = n_out4p0 * vec3(n_out10p0);


// VectorOp:2
	vec3 n_out2p0 = n_out3p0 + n_out6p0;


// Output:0
	VERTEX = n_out2p0;


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p1 = n_out2p0.r;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out2p1));


// Input:14
	vec4 n_out14p0 = COLOR;
	float n_out14p4 = n_out14p0.a;


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, UV);
	float n_out12p1 = n_out12p0.r;


// SmoothStep:13
	float n_in13p1 = 1.00000;
	float n_out13p0 = smoothstep(n_out14p4, n_in13p1, n_out12p1);


	float n_out16p0;
// ProximityFade:16
	float n_in16p0 = 1.00000;
	{
		float __depth_tex = texture(depth_tex_frg_16, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out16p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in16p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:17
	float n_out17p0 = n_out13p0 * n_out16p0;


// ColorParameter:4
	vec4 n_out4p0 = Explosion_Color;


// FloatConstant:6
	float n_out6p0 = 20.000000;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0.xyz) * vec3(n_out6p0);


// Input:15
	vec4 n_out15p0 = COLOR;
	float n_out15p1 = n_out15p0.r;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);
	float n_out7p1 = n_out7p0.r;


// SmoothStep:9
	float n_in9p1 = 1.00000;
	float n_out9p0 = smoothstep(n_out15p1, n_in9p1, n_out7p1);


// VectorOp:8
	vec3 n_out8p0 = n_out5p0 * vec3(n_out9p0);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out17p0;
	EMISSION = n_out8p0;


}
